<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ChronosSystem" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/neon_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/neon_magenta</item>
        <item name="colorSecondaryVariant">@color/neon_amber</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/cyber_bg_deep</item>
        <item name="android:colorBackground">@color/cyber_bg_deep</item>
        <item name="colorSurface">@color/cyber_surface</item>
        <item name="colorOnSurface">@color/cyber_text_primary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="materialButtonStyle">@style/Widget.Chronos.CapsuleButton</item>
        <item name="textInputStyle">@style/Widget.Chronos.TextInput</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Chronos.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Chronos.AlertDialog</item>
    </style>

    <style name="Widget.Chronos.CapsuleButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:fontFamily">@font/orbitron</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Chronos.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/cyber_bg_deep</item>
    </style>

    <style name="ThemeOverlay.Chronos.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Chronos.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/cyber_bg_deep</item>
    </style>

    <style name="Widget.Chronos.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/cyber_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Chronos.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Chronos.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <style name="ThemeOverlay.Chronos.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/cyber_surface</item>
        <item name="colorOnSurface">@color/cyber_text_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Chronos.Dialog</item>
    </style>

    <style name="ShapeAppearance.Chronos.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Chronos.DayChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/cyber_surface_elevated</item>
        <item name="chipStrokeColor">@color/cyber_rim_highlight</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/cyber_text_primary</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>

</resources>
