<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/cyber_aura_secondary"
                android:startColor="@color/cyber_rim_highlight" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/cyber_glass_fill"
                android:startColor="@color/cyber_glass_fill_alt" />
            <corners android:radius="22.5dp" />
        </shape>
    </item>
</layer-list>
