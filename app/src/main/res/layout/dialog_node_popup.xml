<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cyber_surface"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- HarmonyOS Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_harmony_capsule_btn" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNodePopupTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:text="NODE // TELEMETRÍA PRIVADA"
                android:textColor="@color/neon_magenta"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvNodeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/orbitron"
                android:text="NODO DE ENFOQUE"
                android:textColor="@color/cyber_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNodeCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_harmony_capsule_btn"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="00:45:00"
            android:textColor="@color/neon_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNodeMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/rajdhani"
        android:text="Inicio: 09:00 · Duración: 45 min · Reinicio: Diario"
        android:textColor="@color/cyber_text_secondary"
        android:textSize="14sp" />

    <!-- Private Notes Vault (ONLY visible when tapping a node!) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrivateNotesVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cyber_bg_deep"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/neon_magenta"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:text="[ENCRYPTED_PRIVATE_NOTES]"
                android:textColor="@color/neon_magenta"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPrivateNotesContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/rajdhani"
                android:text="Sin notas privadas registradas."
                android:textColor="@color/cyber_text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleNodeActive"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="ACTIVAR / PAUSAR AHORA"
        android:textColor="@color/neon_cyan"
        app:cornerRadius="24dp"
        app:strokeColor="@color/neon_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNodeEdit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="EDITAR"
            android:textColor="@color/cyber_text_primary"
            android:textSize="11sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/neon_cyan"
            app:strokeColor="@color/cyber_border_subtle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNodeRename"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="NOMBRE"
            android:textColor="@color/cyber_text_primary"
            android:textSize="11sp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/cyber_border_subtle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNodeEditNotes"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="NOTAS PRIVADAS"
            android:textColor="@color/neon_magenta"
            android:textSize="11sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_note"
            app:iconTint="@color/neon_magenta"
            app:strokeColor="@color/neon_magenta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNodeDelete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="ELIMINAR"
            android:textColor="@color/neon_magenta"
            android:textSize="11sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/neon_magenta"
            app:strokeColor="@color/neon_magenta" />
    </LinearLayout>

</LinearLayout>
