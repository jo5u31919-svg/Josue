<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cyber_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- HarmonyOS Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_harmony_capsule_btn" />

        <TextView
            android:id="@+id/tvDialogTimerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron"
            android:letterSpacing="0.1"
            android:text="CONFIGURAR NODO TEMPORAL"
            android:textColor="@color/neon_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chronos.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Nombre del temporizador"
            android:textColorHint="@color/cyber_text_secondary"
            app:boxStrokeColor="@color/neon_cyan"
            app:hintTextColor="@color/neon_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTimerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani"
                android:inputType="textCapSentences"
                android:textColor="@color/cyber_text_primary"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/orbitron"
            android:text="HORA DE INICIO Y DÍAS ACTIVOS"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickStartTime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="INICIO: 09:00"
            android:textColor="@color/neon_cyan"
            app:cornerRadius="24dp"
            app:strokeColor="@color/neon_cyan" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMon"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="L" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTue"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="M" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWed"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="X" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThu"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="J" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFri"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="V" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSat"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="false"
                android:text="S" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSun"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="false"
                android:text="D" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chronos.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Duración (minutos)"
            android:textColorHint="@color/cyber_text_secondary"
            app:boxStrokeColor="@color/neon_cyan"
            app:hintTextColor="@color/neon_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDurationMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:inputType="number"
                android:text="45"
                android:textColor="@color/cyber_text_primary"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/orbitron"
            android:text="PERIODO DE REINICIO"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="11sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupResetPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipResetDaily"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Diario" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReset4h"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cada 4h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReset8h"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cada 8h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReset12h"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cada 12h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipResetWeekly"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Semanal" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipResetOnce"
                style="@style/Widget.Chronos.DayChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Único" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chronos.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notas privadas (ocultas hasta pulsar el nodo)"
            android:textColorHint="@color/cyber_text_secondary"
            app:boxStrokeColor="@color/neon_magenta"
            app:hintTextColor="@color/neon_magenta">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrivateNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textColor="@color/cyber_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelTimer"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="CANCELAR"
                android:textColor="@color/cyber_text_secondary"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTimer"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/neon_cyan"
                android:text="PROYECTAR"
                android:textColor="@color/cyber_bg_deep"
                app:cornerRadius="24dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
