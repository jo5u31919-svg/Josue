<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_cyber"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Smooth Neon Sweeping Pulse Ring -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_harmony_icon_badge">

            <ProgressBar
                android:id="@+id/widgetNeonPulse"
                style="?android:attr/progressBarStyle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/widget_neon_pulse_bar" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="ChronosSystem"
                android:src="@drawable/ic_bolt" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/day_reset_label"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widgetChronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/cyber_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetSubInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_harmony_capsule_btn"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="CHRONOS // ACTIVOS: 0"
                android:textColor="@color/neon_magenta"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
