<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- STATE 0: Collapsed HarmonyOS Spatial Floating Orb -->
    <FrameLayout
        android:id="@+id/bubbleOrbContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_overlay_orb"
        android:contentDescription="Burbuja flotante ChronosSystem">

        <ImageView
            android:id="@+id/ivOrbIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Abrir HUD flotante"
            android:src="@drawable/ic_bolt"
            app:tint="@color/neon_cyan" />

        <TextView
            android:id="@+id/tvOrbBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="1dp"
            android:background="@drawable/bg_overlay_orb"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/neon_magenta"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- STATE 1: First Tap - Day Reset Countdown Fluid Capsule Pill -->
    <LinearLayout
        android:id="@+id/bubbleDayResetContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_harmony_icon_badge">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Chronos HUD"
                android:src="@drawable/ic_bolt"
                app:tint="@color/neon_cyan" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOverlayDayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="REINICIO DEL DÍA"
                android:textColor="@color/neon_cyan"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvOverlayDayResetTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textColor="@color/cyber_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca otra vez: ver activos"
                android:textColor="@color/cyber_text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDayPillMinimize"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Minimizar burbuja"
            android:src="@drawable/ic_minimize"
            app:tint="@color/cyber_text_secondary" />
    </LinearLayout>

    <!-- STATE 2: Second Tap - Clean Active Timers Glass Panel -->
    <LinearLayout
        android:id="@+id/bubbleExpandedListContainer"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOverlayPanelHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="CHRONOS // ACTIVOS"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnOverlayMinimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Minimizar burbuja"
                android:src="@drawable/ic_minimize"
                app:tint="@color/cyber_text_secondary" />

            <ImageButton
                android:id="@+id/btnOverlayHide"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ocultar burbuja flotante"
                android:src="@drawable/ic_close"
                app:tint="@color/neon_magenta" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/cyber_border_subtle" />

        <LinearLayout
            android:id="@+id/overlayTimersListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvOverlayEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Sin temporizadores activos según filtro."
            android:textColor="@color/cyber_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
